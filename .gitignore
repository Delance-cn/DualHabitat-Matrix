# 密钥：绝不入库
secrets.json
# 本地配置（含 snowluma.accessToken / consoleToken），模板见 config.example.json
config.json

# 运行状态（聊天记录、会话令牌、唤醒配置、群信息）——绝不入库
state/

# 隔离实例的数据/配置/缓存/状态（可整体删除重建）
.oc/

# 依赖与运行产物
node_modules/
spike/logs/
*.pid
*.log

# 上游原版备份与本机杂物（不上传）
upstream/
NVIDIA Corporation/

# config 备份可能内嵌 accessToken，一律不入库
config.json.bak*

# example / opencode 的备份同样可能带密钥，照 config.json.bak* 的规矩不入库
config.example.json.bak*
opencode.json.bak*

# 桌面端（Electron）依赖与生成物，机器相关设置 —— 不入库
desktop/node_modules/
desktop/bridge-dist/
desktop/dist/
desktop/vendor/
desktop/settings.json
desktop/build/installer-build.log
desktop/build/installer.generated.json
desktop/build/custom.nsh
desktop/build/agreement.utf16le.txt
desktop/build/napcat.7z
desktop/build/napcat-default/
desktop/build/napcat-default.old-*/
desktop/notify-hub.json
desktop/automation.json

# 本机个人模型池备份（不入库）
models.local.json

# .github 不随公开仓库发布（签名工作流需要的 PAT 权限本机没有；要启用就在 GitHub 网页端添加）
.github/
